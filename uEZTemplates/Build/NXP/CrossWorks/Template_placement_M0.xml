<!DOCTYPE Linker_Placement_File>
<Root name="Flash Section Placement">
  <!-- inputsections: If omitted (recommended) then the equivalent input section of *(.name .name.*) is supplied -->
  <!-- Remember to set the CM0_SIZE=0x? Macros in the "Memory Map Macros" Section! -->

  <MemorySegment name="FLASHA0">
    <!-- Can place specific read-only variables here to avoid wasting flash -->
    <!-- Used in M4 project -->
  </MemorySegment>
  <MemorySegment name="$(FLASH_NAME:FLASH)">  
    <!-- Used in M4 project -->
  </MemorySegment>
  <MemorySegment name="FLASHB0">
    <!-- Maybe .init/CM0 vector section could be placed here or place specific read-only variables here to avoid wasting flash -->
    <!-- Used in M4 project -->
  </MemorySegment>
  <MemorySegment name="FLASHB">
    <!-- Used in M4 project -->
  </MemorySegment>

  <MemorySegment name="FLASHA_CM0">
    <!-- Can place Cortex-M0 code here. -->
    <!-- 8-byte aligned padded vector size = (32 IRQ + 16 Cortex IRQ) * 4 = 192 (+0 padding) = 0xC0 total size -->
    <ProgramSection alignment="0x100" load="Yes" name=".vectors" fill="0x00" size_alignment="0x8" start="$(FLASH_START:)" />
    <ProgramSection alignment="4" load="Yes" name=".init" />
    <ProgramSection alignment="4" load="Yes" name=".init_rodata" />   
    <ProgramSection alignment="4" load="Yes" name=".text" />
  </MemorySegment>
  <MemorySegment name="FLASHB_CM0">
    <!-- Can place Cortex-M0 code here. -->
    <ProgramSection alignment="4" load="Yes" name=".dtors" />
    <ProgramSection alignment="4" load="Yes" name=".ctors" />
    <ProgramSection alignment="4" load="Yes" name=".rodata" />
    <ProgramSection alignment="4" load="Yes" name=".constdata"/>
    <ProgramSection alignment="4" load="Yes" name=".conststring"/>
    <ProgramSection alignment="4" load="Yes" runin=".fast_run" name=".fast" />
    <ProgramSection alignment="4" load="Yes" runin=".data_run" name=".data" />
    <ProgramSection alignment="4" load="Yes" runin=".tdata_run" name=".tdata" />
    <ProgramSection alignment="4" load="Yes" name=".ARM.exidx" address_symbol="__exidx_start" end_symbol="__exidx_end"/>
    <ProgramSection alignment="4" load="Yes" name=".ARM.extab" address_symbol="__extab_start" end_symbol="__extab_end" />
  </MemorySegment>

  <!-- Cannot put the same section in both Flash and QSPI at the same time! -->
  <MemorySegment name="SPIFI">
    <!-- Change individual files or folders's .text and .rodata sections to these for QSPI -->    
  </MemorySegment>

  <MemorySegment name="SDRAM_CM0">
    <!-- Placeholders  -->
    <ProgramSection alignment="0x100" load="No" name=".frames"/>
    <ProgramSection alignment="0x100" load="No" name=".video"/>
    <!-- Reserved for emWin memory  -->
    <ProgramSection alignment="0x100" load="No" name=".emWin"/>
    <!-- Reserved for Networking memory  -->
    <ProgramSection alignment="4" load="No" name=".network"/>
    <ProgramSection alignment="4" load="No" name=".mpu"/>
    <ProgramSection alignment="4" load="No" name=".lwip"/>
    <ProgramSection alignment="4" load="No" inputsections="*(.bss .bss.* .gnu.linkonce.b.*) *(COMMON)" name=".bss"/>
    <!-- Move rttbuf section here when using systemview with large trace buffer allocation. May break some RAM tests. -->
    <!-- This is the storage for the RTT buffers so we can have large buffers for console or systemview. For multicore each core has it's own buffer section. -->
    <ProgramSection alignment="4" name=".rttbuf"/>
    <!-- Keep Heap last so we can auto-size it. -->
    <ProgramSection alignment="4" load="No" place_from_segment_end="Yes" size="$(SEGMENT_SIZE_REMAINING)" name=".heap"/>
  </MemorySegment>

  <!-- Pick entire 40KB SRAM2 for CM4 and entire 32KB SRAM1 for CM0. At end of SRAM2, have a shared area. -->
  <MemorySegment name="SRAM1_CM0">
    <ProgramSection alignment="0x100" load="No" name=".vectors_ram" start="$(RAM_START:)"/>
    <ProgramSection alignment="4" load="No" name=".fast_run" />
    <ProgramSection alignment="4" load="No" name=".data_run" />
    <ProgramSection alignment="4" load="No" inputsections="*(.bss.libdebugio.*)" name=".bss.libdebugio"/>
    <ProgramSection alignment="4" load="No" name=".tbss" />
    <ProgramSection alignment="4" load="No" name=".non_init" />
    <ProgramSection alignment="4" load="No" name=".tdata_run" />
    <ProgramSection alignment="8" size="__STACKSIZE__" load="No" name=".stack" />
    <!-- stack_process not currently used and only setup in FreeRTOS MPU ports which we aren't using currently. Comment to remove from output. -->
    <!-- <ProgramSection alignment="8" size="__STACKSIZE_PROCESS__" load="No" name=".stack_process" /> -->
    <ProgramSection alignment="4" load="No" inputsections="*(.IRAM)" name=".IRAM"/>
  </MemorySegment>
  <MemorySegment name="SRAM2_CM0">
    <!-- This is the RTT main structure which is small. Include in SRAM to automatically find it. For multicore RTT use only 1 section for all cores. -->
    <ProgramSection alignment="4" load="No" name=".rtt" />
    <!-- Can put some common shared data between cores in this spot. -->
    <ProgramSection alignment="4" load="No" inputsections="*(.coreshare .coreshare.*)" name=".coreshare"/>
  </MemorySegment>
  
  <!-- Note that AHB section defines are different from the IAR project which is split into 3 sections. -->
  <!-- Note that the shown size of these will be the size-CM0 size. -->
  <MemorySegment name="AHBSRAM1">
    <!-- The AHB area from 0x20000000 to 0x2000C000 -->
    <ProgramSection load="No" name=".usbhostmem"/>
    <ProgramSection load="No" name=".emacmem"/>
    <ProgramSection load="No" name=".mcimem"/>
  </MemorySegment>

  <!-- When the Embedded Trace Buffer is used the 16 kB memory space at 0x2000C000 must not be used by any other process-->
  <MemorySegment name="AHBSRAM2">
    <!-- From 0x2000C000 to 0x2010000-->
  </MemorySegment>
  
  <MemorySegment name="CRP1">
    <ProgramSection alignment="4" keep="$(CRP1_KEEP)" load="Yes" name=".crp1" address_symbol="__crp1_start" end_symbol="__crp1_end" />
  </MemorySegment>
  <MemorySegment name="CRP2">
    <ProgramSection alignment="4" keep="$(CRP2_KEEP)" load="Yes" name=".crp2" address_symbol="__crp2_start" end_symbol="__crp2_end" />
  </MemorySegment>

</Root>
